---
interface Props {
	items: { label: string; href: string }[];
	collapsible?: boolean;
	visibleCount?: number;
}

const { items, collapsible = false, visibleCount = 10 } = Astro.props;
const shown = collapsible ? items.slice(0, visibleCount) : items;
const overflow = collapsible ? items.slice(visibleCount) : [];
---

{items.length > 0 && (
	<nav
		class="-mt-2 mb-7 flex flex-wrap items-center gap-2"
		data-jump
		aria-label="Jump to"
	>
		<span class="text-[13px] font-semibold text-gray-500">Jump to:</span>
		{shown.map((item) => (
			<a
				href={item.href}
				class="rounded-full bg-indigo-50 px-3 py-1 text-[13px] text-indigo-700 no-underline hover:underline"
				>{item.label}</a
			>
		))}
		<span class="inline-flex flex-wrap items-center gap-2 [hidden]:hidden" data-jump-overflow hidden>
			{overflow.map((item) => (
				<a
					href={item.href}
					class="rounded-full bg-indigo-50 px-3 py-1 text-[13px] text-indigo-700 no-underline hover:underline"
					>{item.label}</a
				>
			))}
		</span>
		{overflow.length > 0 && (
			<button
				type="button"
				class="cursor-pointer rounded-full border border-dashed border-indigo-700 bg-indigo-50 px-3 py-1 font-sans text-[13px] text-indigo-700 hover:underline"
				data-jump-toggle
				data-total={items.length}
				data-shown={shown.length}
			>
				Show all {items.length}
			</button>
		)}
	</nav>
)}

{overflow.length > 0 && (
	<script>
		const nav = document.querySelector('[data-jump]');
		const toggle = nav?.querySelector('[data-jump-toggle]');
		const overflow = nav?.querySelector('[data-jump-overflow]');
		if (toggle && overflow) {
			const total = Number(toggle.dataset.total);
			toggle.addEventListener('click', () => {
				const expanded = nav!.classList.toggle('jump--expanded');
				overflow.hidden = !expanded;
				toggle.textContent = expanded ? 'Show less' : `Show all ${total}`;
			});
		}
	</script>
)}
