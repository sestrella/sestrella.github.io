---
interface Props {
	items: { label: string; href: string }[];
	visibleCount?: number;
}

const { items, visibleCount = 5 } = Astro.props;
const shown = items.slice(0, visibleCount);
const overflow = items.slice(visibleCount);
---

{items.length > 0 && (
	<nav class="jump" data-jump aria-label="Jump to">
		<span class="jump-label">Jump to:</span>
		{shown.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
		<span class="jump-overflow" data-jump-overflow hidden>
			{overflow.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</span>
		{overflow.length > 0 && (
			<button
				type="button"
				class="jump-toggle"
				data-jump-toggle
				data-total={items.length}
				aria-expanded="false"
			>
				Show all {items.length}
			</button>
		)}
	</nav>
)}

{overflow.length > 0 && (
	<script>
		for (const nav of document.querySelectorAll<HTMLElement>('[data-jump]')) {
			const toggle = nav.querySelector<HTMLButtonElement>('[data-jump-toggle]');
			const overflow = nav.querySelector<HTMLElement>('[data-jump-overflow]');
			if (!toggle || !overflow) continue;
			const total = Number(toggle.dataset.total);
			toggle.addEventListener('click', () => {
				const expanded = overflow.hidden;
				overflow.hidden = !expanded;
				toggle.setAttribute('aria-expanded', String(expanded));
				toggle.textContent = expanded ? 'Show less' : `Show all ${total}`;
			});
		}
	</script>
)}

<style>
	.jump {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin: -8px 0 28px;
	}

	.jump-label {
		font-size: 13px;
		font-weight: 600;
		color: #6b7280;
	}

	.jump a {
		font-size: 13px;
		color: #4338ca;
		background: #eef2ff;
		border-radius: 999px;
		padding: 4px 12px;
		text-decoration: none;
	}

	.jump a:hover {
		text-decoration: underline;
	}

	.jump-overflow {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	.jump-overflow[hidden] {
		display: none;
	}

	.jump-toggle {
		font-family: inherit;
		font-size: 13px;
		color: #4338ca;
		background: #eef2ff;
		border: 1px dashed #4338ca;
		border-radius: 999px;
		padding: 4px 12px;
		cursor: pointer;
	}

	.jump-toggle:hover {
		text-decoration: underline;
	}
</style>
