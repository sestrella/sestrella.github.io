---
import type { Contribution } from '../lib/contributions';
import ContributionsNav from './ContributionsNav.astro';
import JumpTo from './JumpTo.astro';
import TimelineList from './TimelineList.astro';
import GroupedList from './GroupedList.astro';

export type Group = {
	id: string;
	label: string;
	href: string;
	count: number;
	prs: Contribution[];
};

interface Props {
	active: 'timeline' | 'repositories' | 'languages';
	heading: string;
	count: string;
	back?: { href: string; label: string } | null;
	groups?: Group[];
	quickFilters?: { label: string; href: string }[];
	collapsibleFilters?: boolean;
	prs?: Contribution[];
	showRepo?: boolean;
}

const {
	active,
	heading,
	count,
	back = null,
	groups = [],
	quickFilters = [],
	collapsibleFilters = false,
	prs = [],
	showRepo = true,
} = Astro.props;
---

<main class="mx-auto max-w-[720px] p-6 font-sans text-gray-900">
	{back && (
		<p class="m-0 mb-2">
			<a href={back.href} class="text-sm text-gray-500 no-underline hover:underline"
				>← {back.label}</a
			>
		</p>
	)}
	<h1 class="mt-2 mb-1 text-[28px] [overflow-wrap:anywhere]">{heading}</h1>
	<p class="mb-8 text-sm text-gray-500">{count}</p>

	<ContributionsNav active={active} />

	{quickFilters.length > 0 && (
		<JumpTo items={quickFilters} collapsible={collapsibleFilters} />
	)}

	{groups.length > 0 ? (
		groups.map((group) => (
			<section class="mb-7 scroll-mt-4" id={group.id}>
				<h2 class="m-0 mb-2 flex items-center gap-2 text-base">
					<a href={group.href} class="text-gray-900 no-underline [overflow-wrap:anywhere] hover:underline"
						>{group.label}</a
					>
					<span class="shrink-0 rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700"
						>{group.count}</span
					>
				</h2>
				<GroupedList prs={group.prs} showRepo={false} />
			</section>
		))
	) : prs.length > 0 ? (
		active === 'timeline' ? (
			<TimelineList prs={prs} />
		) : (
			<GroupedList prs={prs} showRepo={showRepo} />
		)
	) : (
		<p class="text-gray-500">No contributions found.</p>
	)}
</main>
