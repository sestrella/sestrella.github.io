---
import type { Contribution } from '../lib/contributions';
import { formatDate, contributionRepoUrl } from '../lib/contributions';

interface Props {
	prs: Contribution[];
	showRepo?: boolean;
}

const { prs, showRepo = true } = Astro.props;
---

<ul class="m-0 list-none p-0">
	{prs.map((pr) => (
		<li class="flex items-baseline justify-between gap-3 border-b border-gray-100 py-1.5 text-[15px] max-[560px]:flex-col max-[560px]:gap-0.5">
			<span class="min-w-0 [overflow-wrap:anywhere]">
				{showRepo && (
					<a class="mr-2 font-semibold text-gray-900 no-underline hover:underline" href={contributionRepoUrl(pr.repo)}>
						{pr.repo}
					</a>
				)}
				<a href={pr.url} class="text-indigo-600 no-underline hover:underline">{pr.title}</a>
				<span class="text-gray-500"> #{pr.number}</span>
			</span>
			<time class="shrink-0 text-[13px] text-gray-400" datetime={pr.mergedAt}>{formatDate(pr.mergedAt)}</time>
		</li>
	))}
</ul>
