---
import type { Contribution } from '../lib/contributions';
import { formatDate, languageSlug } from '../lib/contributions';

interface Props {
	prs: Contribution[];
}

const { prs } = Astro.props;
---

<ol class="timeline">
	{prs.map((pr) => (
		<li>
			<span class="badge">Merged PR</span>
			<div class="body">
				<p class="row">
					<a class="repo" href={`https://github.com/${pr.repo}`}>{pr.repo}</a>
					<a
						class="lang"
						href={`/contributions/language/${languageSlug(pr.language)}`}
					>
						{pr.language}
					</a>
				</p>
				<p class="desc">
					<a href={pr.url}>{pr.title}</a>
					<span class="detail"> · #{pr.number}</span>
				</p>
				{pr.body && (
					<p class="snippet">
						{pr.body.replace(/\s+/g, ' ').trim().slice(0, 140)}
						{pr.body.length > 140 ? '…' : ''}
					</p>
				)}
				<time datetime={pr.mergedAt}>{formatDate(pr.mergedAt)}</time>
			</div>
		</li>
	))}
</ol>

<style>
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 11px;
		top: 4px;
		bottom: 4px;
		width: 2px;
		background: #e5e7eb;
	}

	.timeline li {
		position: relative;
		display: flex;
		gap: 16px;
		padding-bottom: 28px;
	}

	.timeline li::before {
		content: '';
		flex: 0 0 auto;
		width: 12px;
		height: 12px;
		margin-top: 4px;
		border-radius: 50%;
		background: #4f46e5;
		border: 3px solid #fff;
		box-shadow: 0 0 0 1px #e5e7eb;
	}

	.badge {
		flex: 0 0 auto;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 3px 8px;
		border-radius: 999px;
		background: #eef2ff;
		color: #4338ca;
		margin-top: 2px;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
	}

	.repo {
		font-weight: 600;
		color: #111827;
		text-decoration: none;
	}

	.repo:hover {
		text-decoration: underline;
	}

	.lang {
		font-size: 12px;
		color: #4338ca;
		background: #eef2ff;
		border-radius: 999px;
		padding: 2px 8px;
		text-decoration: none;
	}

	.lang:hover {
		text-decoration: underline;
	}

	.desc {
		margin: 0;
		color: #374151;
		overflow-wrap: anywhere;
	}

	.desc a {
		color: #4f46e5;
		text-decoration: none;
	}

	.desc a:hover {
		text-decoration: underline;
	}

	.detail {
		color: #6b7280;
	}

	.snippet {
		margin: 2px 0 0;
		color: #6b7280;
		font-size: 14px;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	time {
		font-size: 13px;
		color: #9ca3af;
	}

	@media (max-width: 560px) {
		.timeline li {
			flex-wrap: wrap;
		}

		.badge {
			margin-left: 28px;
		}
	}
</style>
