---
import type { Contribution } from '../lib/contributions';
import { formatDate, languageSlug } from '../lib/contributions';

interface Props {
	prs: Contribution[];
}

const { prs } = Astro.props;
---

<ol class="relative m-0 list-none p-0 before:absolute before:top-1 before:bottom-1 before:left-[11px] before:w-0.5 before:bg-gray-200">
	{prs.map((pr) => (
		<li class="relative flex gap-4 pb-7 before:mt-1 before:size-3 before:shrink-0 before:content-[''] before:rounded-full before:border-[3px] before:border-white before:bg-indigo-600 before:shadow-[0_0_0_1px_#e5e7eb] max-[560px]:flex-wrap">
			<div class="flex min-w-0 flex-col gap-0.5">
				<p class="m-0 flex flex-wrap items-center gap-2">
					<a class="font-semibold text-gray-900 no-underline hover:underline" href={`https://github.com/${pr.repo}`}>{pr.repo}</a>
					<a
						class="rounded-full bg-indigo-50 px-2 py-0.5 text-xs text-indigo-700 no-underline hover:underline"
						href={`/contributions/languages/${languageSlug(pr.language)}`}
					>
						{pr.language}
					</a>
				</p>
				<p class="m-0 text-gray-700 [overflow-wrap:anywhere]">
					<a href={pr.url} class="text-indigo-600 no-underline hover:underline">{pr.title}</a>
					<span class="text-gray-500"> · #{pr.number}</span>
				</p>
				{pr.body && (
					<p class="mt-0.5 text-sm leading-[1.45] text-gray-500 [overflow-wrap:anywhere]">
						{pr.body.replace(/\s+/g, ' ').trim().slice(0, 140)}
						{pr.body.length > 140 ? '…' : ''}
					</p>
				)}
				<time class="text-[13px] text-gray-400" datetime={pr.mergedAt}>{formatDate(pr.mergedAt)}</time>
			</div>
		</li>
	))}
</ol>
