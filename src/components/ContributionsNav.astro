---
interface Props {
	active: 'timeline' | 'repositories' | 'languages';
}

const { active } = Astro.props;

const items = [
	{ id: 'timeline', label: 'Timeline', href: '/contributions/years' },
	{ id: 'repositories', label: 'By repository', href: '/contributions/repositories' },
	{ id: 'languages', label: 'By language', href: '/contributions/languages' },
] as const;
---

<nav class="mb-7 inline-flex flex-wrap gap-1 rounded-[10px] bg-gray-100 p-1" aria-label="View">
	{items.map((item) => (
		<a
			href={item.href}
			aria-current={active === item.id ? 'page' : undefined}
			class:list={[
				'rounded-[7px] px-3.5 py-1.5 font-sans text-sm text-gray-600 no-underline',
				{ 'bg-white font-medium text-gray-900 shadow-[0_1px_2px_rgb(0_0_0/0.08)]': active === item.id },
			]}
		>
			{item.label}
		</a>
	))}
</nav>
