---
interface Props {
	title?: string;
}

const { title = 'Sebastián Estrella' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/">sestrella</a>
				<a href="/contributions">OSS Contributions</a>
			</nav>
			<nav class="social" aria-label="Social media">
				<a href="https://www.linkedin.com/in/sestrella/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
				<a href="https://github.com/sestrella/" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://x.com/sestrella_h" target="_blank" rel="noopener noreferrer">X</a>
			</nav>
		</header>
		<slot />
		<footer>
			<p>© {new Date().getFullYear()} Sebastián Estrella</p>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	header {
		padding: 16px 24px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 8px 20px;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 20px;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
	}

	nav a {
		color: #111827;
		text-decoration: none;
		font-weight: 500;
	}

	nav a:hover {
		text-decoration: underline;
	}

	.social a {
		font-weight: 400;
		color: #4f46e5;
	}

	footer {
		margin-top: 48px;
		padding: 24px;
		border-top: 1px solid #e5e7eb;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		font-size: 14px;
		color: #6b7280;
		text-align: center;
	}

	footer p {
		margin: 0;
	}
</style>
