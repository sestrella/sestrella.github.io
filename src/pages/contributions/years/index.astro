---
import Layout from '../../../layouts/Layout.astro';
import ContributionsNav from '../../../components/ContributionsNav.astro';
import JumpTo from '../../../components/JumpTo.astro';
import TimelineList from '../../../components/TimelineList.astro';
import { loadContributions } from '../../../lib/contributions';

const { mergedPrs, repoCount, years } = await loadContributions();
const yearFilters = years.map(({ year }) => ({
	label: String(year),
	href: `#year-${year}`,
}));
---

<Layout title="OSS Contributions · Sebastián Estrella">
	<main class="mx-auto max-w-[720px] p-6 font-sans text-gray-900">
		<h1 class="mt-2 mb-1 text-[28px]">OSS Contributions</h1>
		<p class="m-0 mb-6 text-gray-600">
			Merged pull requests in other people's repositories, pulled from the GitHub API at build
			time.
		</p>
		<p class="m-0 mb-8 text-sm text-gray-500">
			{mergedPrs.length} merged pull requests across {repoCount} repositories
		</p>

		<ContributionsNav active="timeline" />
		<JumpTo items={yearFilters} />

		{years.map(({ year, prs }) => (
			<section class="mb-8 scroll-mt-4" id={`year-${year}`}>
				<h2 class="relative m-0 mb-4 flex items-center gap-3 text-lg text-gray-900 after:flex-1 after:h-px after:bg-gray-200 after:content-['']">
					<a href={`/contributions/years/${year}`} class="text-gray-900 no-underline hover:underline"
						>{year}</a
					>
				</h2>
				<TimelineList prs={prs} />
			</section>
		))}
	</main>
</Layout>
