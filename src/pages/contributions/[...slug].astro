---
import Layout from '../../layouts/Layout.astro';
import ContributionsNav from '../../components/ContributionsNav.astro';
import QuickFilters from '../../components/QuickFilters.astro';
import TimelineList from '../../components/TimelineList.astro';
import GroupedList from '../../components/GroupedList.astro';
import { loadContributions, languageSlug, anchorId } from '../../lib/contributions';
import type { ContributionData } from '../../lib/contributions';

export async function getStaticPaths() {
	const data = await loadContributions();
	const repoOverview = { params: { slug: 'repository' } };
	const repoPaths = data.repoGroups.map(({ repo }) => ({
		params: { slug: `repository/${repo}` },
	}));
	const langOverview = { params: { slug: 'language' } };
	const langPaths = data.languageGroups.map(({ language }) => ({
		params: { slug: `language/${languageSlug(language)}` },
	}));
	const yearPaths = data.years.map(({ year }) => ({ params: { slug: String(year) } }));
	return [repoOverview, ...repoPaths, langOverview, ...langPaths, ...yearPaths];
}

const data: ContributionData = await loadContributions();
const segments = (Astro.params.slug ?? '').split('/').filter(Boolean);
const [head, ...rest] = segments;

type Group = { id: string; label: string; href: string; count: number; prs: typeof data.mergedPrs };

let active: 'timeline' | 'repository' | 'language' = 'timeline';
let heading = '';
let count = '';
let groups: Group[] = [];
let quickFilters: { label: string; href: string }[] = [];
let prs = data.mergedPrs;
let showRepo = true;
let back: { href: string; label: string } | null = null;

if (segments.length === 1 && /^\d{4}$/.test(segments[0])) {
	const year = Number(segments[0]);
	active = 'timeline';
	heading = `Contributions in ${year}`;
	prs = data.byYear[year] ?? [];
	count = `${prs.length} merged pull requests in ${year}`;
	back = { href: '/contributions', label: 'All contributions' };
} else if (head === 'repository') {
	active = 'repository';
	if (rest.length === 0) {
		heading = 'Contributions by repository';
		count = `${data.mergedPrs.length} merged pull requests across ${data.repoCount} repositories`;
		groups = data.repoGroups.map(({ repo, prs, count }) => ({
			id: `repo-${anchorId(repo)}`,
			label: repo,
			href: `/contributions/repository/${repo}`,
			count,
			prs,
		}));
		quickFilters = groups.slice(0, 5).map(({ id, label }) => ({ label, href: `#${id}` }));
	} else {
		const repo = rest.join('/');
		heading = repo;
		prs = data.byRepo[repo] ?? [];
		count = `${prs.length} merged pull requests`;
		showRepo = false;
		back = { href: '/contributions/repository', label: 'All repositories' };
	}
} else if (head === 'language') {
	active = 'language';
	if (rest.length === 0) {
		heading = 'Contributions by language';
		count = `${data.mergedPrs.length} merged pull requests`;
		groups = data.languageGroups.map(({ language, prs, count }) => ({
			id: `lang-${anchorId(language)}`,
			label: language,
			href: `/contributions/language/${languageSlug(language)}`,
			count,
			prs,
		}));
		quickFilters = groups.slice(0, 5).map(({ id, label }) => ({ label, href: `#${id}` }));
	} else {
		const slug = rest.join('/');
		const language = data.languages.find((l) => languageSlug(l) === slug) ?? slug;
		heading = language;
		prs = data.byLanguage[language] ?? [];
		count = `${prs.length} merged pull requests in ${language}`;
		back = { href: '/contributions/language', label: 'All languages' };
	}
}
---

<Layout title={`${heading} · Sebastián Estrella`}>
	<main>
		{back && (
			<p class="back">
				<a href={back.href}>← {back.label}</a>
			</p>
		)}
		<h1>{heading}</h1>
		<p class="count">{count}</p>

		<ContributionsNav active={active} />

		{quickFilters.length > 0 && <QuickFilters items={quickFilters} />}

		{groups.length > 0 ? (
			groups.map((group) => (
				<section class="group" id={group.id}>
					<h2>
						<a href={group.href}>{group.label}</a>
						<span class="group-count">{group.count}</span>
					</h2>
					<GroupedList prs={group.prs} showRepo={false} />
				</section>
			))
		) : prs.length > 0 ? (
			active === 'timeline' ? (
				<TimelineList prs={prs} />
			) : (
				<GroupedList prs={prs} showRepo={showRepo} />
			)
		) : (
			<p class="empty">No contributions found.</p>
		)}
	</main>
</Layout>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 24px;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #111827;
	}

	.back {
		margin: 0 0 8px;
	}

	.back a {
		color: #6b7280;
		text-decoration: none;
		font-size: 14px;
	}

	.back a:hover {
		text-decoration: underline;
	}

	h1 {
		font-size: 28px;
		margin: 8px 0 4px;
		overflow-wrap: anywhere;
	}

	.count {
		font-size: 14px;
		color: #6b7280;
		margin: 0 0 32px;
	}

	.group {
		margin-bottom: 28px;
		scroll-margin-top: 16px;
	}

	.group h2 {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 16px;
		margin: 0 0 8px;
	}

	.group h2 a {
		color: #111827;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.group h2 a:hover {
		text-decoration: underline;
	}

	.group-count {
		flex: 0 0 auto;
		font-size: 12px;
		font-weight: 600;
		color: #4338ca;
		background: #eef2ff;
		border-radius: 999px;
		padding: 2px 8px;
	}

	.empty {
		color: #6b7280;
	}
</style>
