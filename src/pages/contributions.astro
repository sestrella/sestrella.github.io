---
import Layout from '../layouts/Layout.astro';
import ContributionsNav from '../components/ContributionsNav.astro';
import TimelineList from '../components/TimelineList.astro';
import { loadContributions } from '../lib/contributions';

const { mergedPrs, repoCount, years } = await loadContributions();
---

<Layout title="OSS Contributions · Sebastián Estrella">
	<main>
		<h1>Open Source Contributions</h1>
		<p class="sub">
			Merged pull requests in other people's repositories, pulled from the GitHub API at build
			time.
		</p>
		<p class="count">
			{mergedPrs.length} merged pull requests across {repoCount} repositories
		</p>

		<ContributionsNav active="timeline" />

		{years.map(({ year, prs }) => (
			<section class="year">
				<h2 class="year-header">
					<a href={`/contributions/${year}`}>{year}</a>
				</h2>
				<TimelineList prs={prs} />
			</section>
		))}
	</main>
</Layout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 24px;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #111827;
	}

	h1 {
		font-size: 28px;
		margin: 8px 0 4px;
	}

	.sub {
		color: #4b5563;
		margin: 0 0 24px;
	}

	.count {
		font-size: 14px;
		color: #6b7280;
		margin: 0 0 32px;
	}

	.year {
		margin-bottom: 32px;
	}

	.year-header {
		font-size: 18px;
		margin: 0 0 16px;
		color: #111827;
		position: relative;
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.year-header::after {
		content: '';
		flex: 1;
		height: 1px;
		background: #e5e7eb;
	}

	.year-header a {
		color: #111827;
		text-decoration: none;
	}

	.year-header a:hover {
		text-decoration: underline;
	}
</style>
