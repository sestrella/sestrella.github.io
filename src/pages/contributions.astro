---
import Layout from '../layouts/Layout.astro';

const USERNAME = process.env.GITHUB_USERNAME ?? 'sestrella';

const headers = {
	Accept: 'application/vnd.github+json',
	'X-GitHub-Api-Version': '2022-11-28',
};

if (process.env.GITHUB_TOKEN) {
	headers.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
}

async function fetchMergedPrs(username: string) {
	const prs = [];
	for (let page = 1; page <= 10; page++) {
		const query = `author:${username} is:pr is:merged`;
		const res = await fetch(
			`https://api.github.com/search/issues?q=${encodeURIComponent(query)}&sort=updated&order=desc&per_page=100&page=${page}`,
			{ headers },
		);
		if (!res.ok) {
			throw new Error(
				`GitHub API request failed (${res.status}). Set GITHUB_TOKEN for a higher rate limit.`,
			);
		}
		const data = await res.json();
		const batch = data.items ?? [];
		if (batch.length === 0) break;
		prs.push(...batch);
		if (prs.length >= data.total_count) break;
	}
	return prs;
}

const mergedPrs = (await fetchMergedPrs(USERNAME))
	.filter((pr) => pr.repository_url.split('/repos/')[1].split('/')[0] !== USERNAME)
	.map((pr) => ({
		repo: pr.repository_url.replace('https://api.github.com/repos/', ''),
		number: pr.number,
		title: pr.title,
		url: pr.html_url,
		mergedAt: pr.pull_request?.merged_at ?? pr.closed_at ?? pr.updated_at,
		body: pr.body,
	}))
	.sort((a, b) => new Date(b.mergedAt).getTime() - new Date(a.mergedAt).getTime());

const repoCount = new Set(mergedPrs.map((pr) => pr.repo)).size;

function formatDate(iso: string) {
	return new Date(iso).toLocaleDateString('en-US', {
		month: 'short',
		day: 'numeric',
		year: 'numeric',
	});
}
---

<Layout title={`OSS Contributions · Sebastián Estrella`}>
	<main>
		<h1>Open Source Contributions</h1>
		<p class="sub">
			Merged pull requests in other people's repositories, pulled from the GitHub API at build
			time.
		</p>
		<p class="count">
			{mergedPrs.length} merged pull requests across {repoCount} repositories
		</p>

		{mergedPrs.length > 0 ? (
			<ol class="timeline">
				{mergedPrs.map((pr) => (
					<li>
						<span class="badge">Merged PR</span>
						<div class="body">
							<a class="repo" href={`https://github.com/${pr.repo}`}>{pr.repo}</a>
							<p class="desc">
								<a href={pr.url}>{pr.title}</a>
								<span class="detail"> · #{pr.number}</span>
							</p>
							{pr.body && (
								<p class="snippet">
									{pr.body.replace(/\s+/g, ' ').trim().slice(0, 140)}
									{pr.body.length > 140 ? '…' : ''}
								</p>
							)}
							<time datetime={pr.mergedAt}>{formatDate(pr.mergedAt)}</time>
						</div>
					</li>
				))}
			</ol>
		) : (
			<p class="empty">No merged pull requests found in other repositories.</p>
		)}
	</main>
</Layout>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 24px;
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		color: #111827;
	}

	h1 {
		font-size: 28px;
		margin: 8px 0 4px;
	}

	.sub {
		color: #4b5563;
		margin: 0 0 24px;
	}

	.count {
		font-size: 14px;
		color: #6b7280;
		margin: 0 0 32px;
	}

	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
	}

	.timeline::before {
		content: '';
		position: absolute;
		left: 11px;
		top: 4px;
		bottom: 4px;
		width: 2px;
		background: #e5e7eb;
	}

	.timeline li {
		position: relative;
		display: flex;
		gap: 16px;
		padding-bottom: 28px;
	}

	.timeline li::before {
		content: '';
		flex: 0 0 auto;
		width: 12px;
		height: 12px;
		margin-top: 4px;
		border-radius: 50%;
		background: #4f46e5;
		border: 3px solid #fff;
		box-shadow: 0 0 0 1px #e5e7eb;
	}

	.badge {
		flex: 0 0 auto;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 3px 8px;
		border-radius: 999px;
		background: #eef2ff;
		color: #4338ca;
		margin-top: 2px;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.repo {
		font-weight: 600;
		color: #111827;
		text-decoration: none;
	}

	.repo:hover {
		text-decoration: underline;
	}

	.desc {
		margin: 0;
		color: #374151;
		overflow-wrap: anywhere;
	}

	.desc a {
		color: #4f46e5;
		text-decoration: none;
	}

	.desc a:hover {
		text-decoration: underline;
	}

	.detail {
		color: #6b7280;
	}

	.snippet {
		margin: 2px 0 0;
		color: #6b7280;
		font-size: 14px;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	time {
		font-size: 13px;
		color: #9ca3af;
	}

	.empty {
		color: #6b7280;
	}

	@media (max-width: 560px) {
		.timeline li {
			flex-wrap: wrap;
		}

		.badge {
			margin-left: 28px;
		}
	}
</style>
