---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<p>
			I'm a senior tech lead with expertise leading teams across a variety of projects and
			technical stacks. My background includes functional programming and DevOps. I regularly
			contribute to OSS, handle production issues, and lead initiatives for the engineering
			department. I enjoy working with niche technologies like Haskell and Nix, as well as
			collaborating with others.
		</p>
	</main>
</Layout>

<style>
	main {
		padding: 24px;
		max-width: 640px;
		margin: 0 auto;
	}

	p {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		font-size: 18px;
		line-height: 1.7;
		color: #111827;
		margin: 0;
	}
</style>
